<Window x:Class="FocusCoach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FocusCoach.App"
        Title="FocusCoach" Width="420" SizeToContent="Height" Topmost="True" ShowActivated="False"
        WindowStyle="None" ResizeMode="CanMinimize" Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing" StateChanged="MainWindow_StateChanged">
    <!--
      [仮案-19] S-02(開始準備)と S-04(ミニパネル)を1つのウィンドウに同居させている。
      見た目は 03章 §3.4(近未来の業務支援ツール、低刺激の青緑系、読みやすい書体、短い文言)。
      タイトルバーは WindowChrome で独自の細い帯にする(ドラッグ移動・スナップは OS の標準動作のまま)。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- 縁の色で状態を知らせる(09章 §9.4.4)。色はコードビハインドで切り替える -->
    <Border x:Name="EdgeBorder" BorderThickness="2" BorderBrush="{StaticResource Line}">
        <DockPanel>
            <!-- タイトル帯 -->
            <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Panel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextDim}" Margin="0,0,9,0"/>
                    <TextBlock Text="FOCUS COACH" FontFamily="{StaticResource NumFont}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="StatusText" Text="{loc:T status.idle}" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 表示言語の切り替え(JA / EN)。現在の言語が文字になる。トレイのメニューとホットキー(Ctrl+Alt+F8)でも切り替えられる -->
                    <Button x:Name="LangButton" Style="{StaticResource CaptionButton}" Content="{loc:T lang.button}" FontFamily="{StaticResource NumFont}"
                            FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Width="40"
                            AutomationProperties.Name="{loc:T lang.tooltip.nokey}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Lang_Click"/>
                    <!-- コンパクト表示(F8)。画面を必要な要素だけに縮め、半透明にして下の画面を見えるようにする -->
                    <Button x:Name="CompactButton" Style="{StaticResource CaptionButton}" Content="&#xE73F;" AutomationProperties.Name="{loc:T main.compact_name}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Compact_Click"/>
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="{loc:T main.minimize_tip}" AutomationProperties.Name="{loc:T main.minimize_name}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                    <!-- アプリを閉じる。作業中の「タスク完了」(タスクを終える)とは別 -->
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="{loc:T main.close_tip}" AutomationProperties.Name="{loc:T main.close_tip}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click"/>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource AccentGradient}" Opacity="0.55"/>
            </Grid>

            <StackPanel Margin="18,12,18,14">
                <!-- ===== 開始準備(S-02 の簡易版) ===== -->
                <StackPanel x:Name="StartPanel">
                    <!-- 中断中・異常終了した実行(F-15、F-16) -->
                    <StackPanel x:Name="RecoverPanel"/>

                    <!-- タスク: 過去に終了したもの・手順を登録したものから選ぶ。新しい名前も入力できる(05 F-01・F-02) -->
                    <TextBlock Text="{loc:T main.task}" Style="{StaticResource FieldLabel}" Margin="0,2,0,3"/>
                    <Grid>
                        <ComboBox x:Name="CategoryBox" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                                  FontSize="15" Text="" MaxDropDownHeight="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Background="Transparent">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:T main.task_remove}" Click="ArchiveCategory_Click"/>
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{StaticResource TextDim}"
                                                   FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- 空のときだけ出す案内(クリックは下の入力欄に通す) -->
                        <TextBlock x:Name="CategoryPlaceholder" Text="{loc:T main.task_placeholder}" FontSize="14" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextDim}" Margin="9,0,34,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="{loc:T main.task_hint}"/>

                    <TextBlock Text="{loc:T main.project}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ProjectBox"/>

                    <!-- 手順: 表示のみ。編集は手順エディタ(S-02a)で行う -->
                    <DockPanel Margin="0,10,0,3">
                        <Button x:Name="EditStepsButton" DockPanel.Dock="Right" Content="{loc:T main.edit_steps}" Click="EditSteps_Click" Margin="0" Padding="10,3" FontSize="12"/>
                        <TextBlock Text="{loc:T main.steps}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Bottom"/>
                    </DockPanel>
                    <Border Background="{StaticResource Panel}" CornerRadius="4" Padding="8,6">
                        <TextBlock x:Name="StepsText" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                    <TextBlock x:Name="StepsSourceText" Style="{StaticResource Hint}"/>

                    <TextBlock Text="{loc:T main.apps}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TaskAppsBox"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{loc:T main.apps_hint}"/>

                    <!-- 最初の一手(I-05)。前回の内容が初期値になる -->
                    <TextBlock Text="{loc:T main.first_step}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FirstStepBox"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{loc:T main.first_step_hint}"/>

                    <!-- 過去の実績からのガイド -->
                    <Border Margin="0,14,0,0" Padding="10,8" Background="{StaticResource Panel}" CornerRadius="6"
                            BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0">
                        <TextBlock x:Name="GuideText" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"/>
                    </Border>

                    <CheckBox x:Name="DryRunBox" IsChecked="True" Margin="0,12,0,0"
                              Content="{loc:T main.dryrun}"/>
                    <Button x:Name="StartButton" Content="{loc:T main.start}" Style="{StaticResource PrimaryButton}"
                            Margin="0,14,0,0" Click="Start_Click"/>
                    <TextBlock x:Name="StartHint" Text="{loc:T main.start_hint}" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ===== 作業中ミニパネル(S-04) ===== -->
                <StackPanel x:Name="RunPanel" Visibility="Collapsed">
                    <TextBlock x:Name="StepText" FontFamily="{StaticResource NumFont}" FontSize="11"
                               Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="SubtaskText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                        <TextBlock x:Name="TimerText" FontFamily="{StaticResource NumFont}" FontSize="34"/>
                        <TextBlock x:Name="TargetText" FontFamily="{StaticResource NumFont}" FontSize="13"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="10,0,0,7"/>
                    </StackPanel>
                    <ProgressBar x:Name="SubtaskProgress" Style="{StaticResource ThinProgress}"/>
                    <TextBlock x:Name="ElapsedText" FontFamily="{StaticResource NumFont}" FontSize="12"
                               Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>

                    <!-- 最初の一手(I-05)。最初のサブタスクの間だけ出す -->
                    <TextBlock x:Name="FirstStepText" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource Green}" Visibility="Collapsed"/>

                    <!-- 周辺表示(09章 §9.4.4)。色とアイコンで知らせる -->
                    <TextBlock x:Name="EdgeText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Button x:Name="NextButton" Content="{loc:T main.next}" Click="Next_Click" Style="{StaticResource AccentButton}"/>
                        <Button x:Name="SkipButton" Content="{loc:T main.skip}" Click="Skip_Click"/>
                        <!-- 割り込み対応(しおり)。押すのをためらわないよう、1回押すだけ・確認なし・警告色なし(design-0.12A §1.2) -->
                        <Button x:Name="InterruptButton" Click="Interrupt_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="InterruptIcon" Data="{StaticResource BookmarkIcon}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.4" Fill="{StaticResource AccentSoft}"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="InterruptLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MemoButton" Click="Memo_Click"/>
                        <Button x:Name="SuspendButton" Content="{loc:T main.suspend}" Click="Suspend_Click" Style="{StaticResource QuietButton}"/>
                        <Button x:Name="EndButton" Content="{loc:T main.end}" Click="End_Click" Style="{StaticResource QuietButton}" ToolTip="{loc:T main.end_tip}"/>
                    </UniformGrid>
                    <TextBlock x:Name="HotkeyText" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- 離席から戻ったときの問いかけ(09章 §9.4.1a) -->
                    <Border x:Name="AwayPanel" Visibility="Collapsed" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="AwayText" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="AwayYesButton" Content="{loc:T common.yes}" Click="AwayYes_Click" Style="{StaticResource AccentButton}"/>
                                <Button x:Name="AwayNoButton" Content="{loc:T common.no}" Click="AwayNo_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 復帰カード(S-11) -->
                    <Border x:Name="ResumeCardPanel" Visibility="Collapsed" Style="{StaticResource Card}" BorderBrush="{StaticResource Accent2}">
                        <StackPanel>
                            <TextBlock Text="{loc:T main.resume_card}" FontSize="12" Foreground="{StaticResource Accent2}" Margin="0,0,0,4"/>
                            <!-- 次の一手を一番上に大きく(09章 §9.4.2、I-01) -->
                            <TextBlock x:Name="NextStepText" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ResumeText" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextMuted}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="RestoreWorkButton" Content="{loc:T main.back_to_work}" Click="RestoreWork_Click" Style="{StaticResource AccentButton}"/>
                                <Button x:Name="EditNoteButton" Content="{loc:T main.edit_note}" Click="EditNote_Click"/>
                                <Button x:Name="CloseCardButton" Content="{loc:T main.resume_as_is}" Click="CloseCard_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- あとでやること(S-12)。1件以上あるときだけ出す。クリックで一覧(design-0.12A §5.2) -->
                <Button x:Name="FollowupButton" Style="{StaticResource QuietButton}" Visibility="Collapsed" Click="Followups_Click"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Padding="8,3" FontSize="12" AutomationProperties.Name="{loc:T tray.followups}"
                        ToolTip="{loc:T main.followup_tip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource BookmarkIcon}" Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource Accent2}"
                              StrokeThickness="1.3" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FollowupText" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- デバッグ(08章 §8.5 の簡易版) -->
                <Expander Header="{loc:T main.log}" Margin="0,12,0,0" Foreground="{StaticResource TextDim}" FontSize="11">
                    <TextBox x:Name="LogBox" Height="140" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </Expander>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
